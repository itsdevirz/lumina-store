# ====================================================================
# Lumina E-Commerce Store - Apache & LiteSpeed Configuration
# Fixes 404 Not Found error on page refresh for SPA sub-routes
# ====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If requesting index.html directly, stop rewriting
  RewriteRule ^index\.html$ - [L]

  # 2. Allow existing real files or directories (images, assets, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Allow direct access to uploaded files and built assets
  RewriteRule ^uploads/(.*)$ uploads/$1 [L]
  RewriteRule ^assets/(.*)$ assets/$1 [L]

  # 4. Route all other requests to /index.html with absolute root slash
  # (Crucial: Using /index.html prevents LiteSpeed from resolving to /product/index.html)
  RewriteRule . /index.html [L]
</IfModule>

# Fallback error handler: If mod_rewrite is disabled or bypassed by server, serve /index.html
ErrorDocument 404 /index.html

# Enable Gzip / Deflate compression for optimal speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Security: Prevent directory listing
Options -Indexes

# Character encoding
AddDefaultCharset UTF-8

